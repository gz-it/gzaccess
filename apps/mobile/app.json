{
  "expo": {
    "name": "GzAccess",
    "slug": "gzaccess",
    "scheme": "gzaccess",
    "version": "0.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.gzit.gzaccess",
      "supportsTablet": false
    },
    "android": {
      "package": "com.gzit.gzaccess",
      "adaptiveIcon": {
        "backgroundColor": "#18211f"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "GzAccess usa la camara para registrar tu rostro de acceso.",
          "photosPermission": "GzAccess puede seleccionar una imagen solo para tu credencial de acceso."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:4000/api/v1"
    }
  }
}
