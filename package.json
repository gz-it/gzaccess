{
  "name": "gzaccess",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "db:generate": "pnpm --filter @gzaccess/database db:generate",
    "dev": "pnpm --parallel --filter @gzaccess/api --filter @gzaccess/web --filter @gzaccess/worker --filter @gzaccess/edge dev",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm --filter @gzaccess/contracts build && pnpm --filter @gzaccess/auth build && pnpm --filter @gzaccess/device-core build && pnpm --filter @gzaccess/device-simulator build && pnpm -r --sort --workspace-concurrency=1 --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
